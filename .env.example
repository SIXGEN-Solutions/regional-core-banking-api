# Regional Core Banking API local Docker environment.
# Local-development values only. Never place production secrets here.

REGIONAL_API_PORT=8080
# Published API image. Override with the immutable 6-character Git SHA tag when needed.
REGIONAL_API_IMAGE=d22002/regional-core-banking-api:latest

REGIONAL_POSTGRES_PORT=15432
REGIONAL_TECHNICAL_DB_PASSWORD=regional_core_banking_dev

ORACLE_PORT=1521
ORACLE_APP_USERNAME=REGIONAL_MOCK
ORACLE_APP_PASSWORD=regional_oracle_dev

# Local-only example. Production HMAC keys must use the approved secret mechanism.
REGIONAL_OTP_HMAC_ACTIVE_KEY_VERSION=v1
REGIONAL_OTP_HMAC_KEYS=v1:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Mailtrap SMTP for local Docker OTP EMAIL delivery.
# Copy .env.example to .env and replace these placeholders locally.
# Never commit real SMTP credentials.
REGIONAL_OTP_EMAIL_ENABLED=true
REGIONAL_OTP_EMAIL_HOST=sandbox.smtp.mailtrap.io
REGIONAL_OTP_EMAIL_PORT=587
REGIONAL_OTP_EMAIL_USERNAME=replace-with-mailtrap-username
REGIONAL_OTP_EMAIL_PASSWORD=replace-with-mailtrap-password
REGIONAL_OTP_EMAIL_TLS=true
REGIONAL_OTP_EMAIL_SENDER=no-reply@regional-test.local
